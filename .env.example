# Vercel AI Gateway key (https://vercel.com/ai-gateway). Leave empty to run in
# "sample mode" with a pre-written lesson. On Vercel, the deployment's OIDC
# token is used automatically if no key is set.
AI_GATEWAY_API_KEY=

# Optional overrides (any AI Gateway model id)
# LESSON_MODEL=anthropic/claude-haiku-5.5
# Thinking effort: none (fastest, default) | minimal | low | medium | high
# LESSON_REASONING=none
# TTS_MODEL=openai/tts-1
# TTS_VOICE=nova

# Force sample mode even when a key is present
# MOCK_AI=1
